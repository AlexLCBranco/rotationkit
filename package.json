{
  "name": "rotationkit",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc",
    "probe": "tsx scripts/probe.ts",
    "fetch-season": "tsx scripts/fetch-season.ts",
    "fetch-game": "tsx scripts/fetch-game.ts",
    "normalize": "tsx scripts/normalize.ts",
    "validate-all": "tsx scripts/validate-all.ts",
    "make-fixture": "tsx scripts/make-fixture.ts",
    "update-data": "npm run fetch-season && npm run normalize && npm run validate-all",
    "pretest": "node scripts/check-lists.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "undici": "^7.30.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
